{
  "$schema": "https://opencode.ai/config.json",

  // Artefactos de Flutter/Dart e IDE: no aportan contexto y ensucian el watcher.
  "watcher": {
    "ignore": [
      "**/build/**",
      "**/.dart_tool/**",
      "**/.idea/**",
      "**/coverage/**"
    ]
  },

  // Datos de salud: nada de credenciales locales en el contexto del modelo.
  // El último patrón que coincide gana.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // Operaciones con impacto remoto o masivo: confirmar antes de ejecutar.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "dart fix --apply*", "effect": "ask" }
  ]
}
